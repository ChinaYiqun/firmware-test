2_t head = (uint32_t)atomic_get(&rb->head);\n+\tuint32_t tail = (uint32_t)atomic_get(&rb->tail);\n+\n+\treturn (head - tail) >= (uint32_t)rb->size;\n }\n \n size_t ring_buf_count(const ring_buf_t *rb)\n {\n-\treturn (size_t)(atomic_get(&rb->head) - atomic_get(&rb->tail));\n+\tuint32_t head = (uint32_t)atomic_get(&rb->head);\n+\tuint32_t tail = (uint32_t)atomic_get(&rb->tail);\n+\n+\treturn (size_t)(head - tail);\n }\n \n size_t ring_buf_free_space(const ring_buf_t *rb)\n {\n","filediff":{"file":"D:\\firmware-test\\experiments\\2026-10-20-qwen38-27b-harness-comparison\\runs\\run-20261020-154440-282906\\tasks\\opencode__isr-concurrency-001__1\\a10eac8c\\workspace\\submission\\main.c","patch":"Index: D:\\firmware-test\\experiments\\2026-10-20-qwen38-27b-harness-comparison\\runs\\run-20261020-154440-282906\\tasks\\opencode__isr-concurrency-001__1\\a10eac8c\\workspace\\submission\\main.c\n===================================================================\n--- D:\\firmware-test\\experiments\\2026-10-20-qwen38-27b-harness-comparison\\runs\\run-20261020-154440-282906\\tasks\\opencode__isr-concurrency-001__1\\a10eac8c\\workspace\\submission\\main.c\n+++ D:\\firmware-test\\experiments\\2026-10-20-qwen38-27b-harness-comparison\\runs\\run-20261020-154440-282906\\tasks\\opencode__isr-concurrency-001__1\\a10eac8c\\workspace\\submission\\main.c\n@@ -200,15 +200,20 @@\n }\n \n bool ring_buf_is_full(const ring_buf_t *rb)\n {\n-\treturn (size_t)(atomic_get(&rb->head) - atomic_get(&rb->tail)) >=\n-\t       rb->size;\n+\tuint32_t head = (uint32_t)atomic_get(&rb->head);\n+\tuint32_t tail = (uint32_t)atomic_get(&rb->tail);\n+\n+\treturn (head - tail) >= (uint32_t)rb->size;\n }\n \n size_t ring_buf_count(const ring_buf_t *rb)\n {\n-\treturn (size_t)(atomic_get(&rb->head) - atomic_get(&rb->tail));\n+\tuint32_t head = (uint32_t)atomic_get(&rb->head);\n+\tuint32_t tail = (uint32_t)atomic_get(&rb->tail);\n+\n+\treturn (size_t)(head - tail);\n }\n \n size_t ring_buf_free_space(const ring_buf_t *rb)\n {\n","additions":8,"deletions":3},"truncated":false},"title":"firmware-test\\experiments\\2026-10-20-qwen38-27b-harness-comparison\\runs\\run-20261020-154440-282906\\tasks\\opencode__isr-concurrency-001__1\\a10eac8c\\workspace\\submission\\main.c","time":{"start":1792483485260,"end":1792483485277}},"metadata":{"anthropic":{"caller":{"type":"direct"}}},"id":"prt_158574cd4001RJkuOTzOdXDolW","sessionID":"ses_ea7ae49edffeqHl0eGUfeYjbPJ","messageID":"msg_158570e74001n5tzDGekWpPkKg"}}
