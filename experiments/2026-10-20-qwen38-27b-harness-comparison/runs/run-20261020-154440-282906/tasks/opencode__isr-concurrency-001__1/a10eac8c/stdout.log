n, rb->size - (tail % rb->size));\n\n\tmemcpy(data, &rb->storage[tail % rb->size], first_chunk);\n\tif (n > first_chunk) {\n\t\tmemcpy(&data[first_chunk], &rb->storage[0], n - first_chunk);\n\t}\n\n\tatomic_set(&rb->tail, tail + (uint32_t)n);\n\treturn n;\n}\n\nbool ring_buf_is_empty(const ring_buf_t *rb)\n{\n\treturn atomic_get(&rb->head) == atomic_get(&rb->tail);\n}\n\nbool ring_buf_is_full(const ring_buf_t *rb)\n{\n\treturn (size_t)(atomic_get(&rb->head) - atomic_get(&rb->tail)) >=\n\t       rb->size;\n}\n\nsize_t ring_buf_count(const ring_buf_t *rb)\n{\n\treturn (size_t)(atomic_get(&rb->head) - atomic_get(&rb->tail));\n}\n\nsize_t ring_buf_free_space(const ring_buf_t *rb)\n{\n\treturn rb->size - ring_buf_count(rb);\n}\n\n/* ==========================================================================","lineStart":140,"lineEnd":214,"totalLines":318,"truncated":true}},"title":"firmware-test\\experiments\\2026-10-20-qwen38-27b-harness-comparison\\runs\\run-20261020-154440-282906\\tasks\\opencode__isr-concurrency-001__1\\a10eac8c\\workspace\\submission\\main.c","time":{"start":1792483454225,"end":1792483454257}},"metadata":{"anthropic":{"caller":{"type":"direct"}}},"id":"prt_15856e974001xAJ3MVDm5XItPy","sessionID":"ses_ea7ae49edffeqHl0eGUfeYjbPJ","messageID":"msg_15856d2550013p3cXMxH2ii13L"}}
